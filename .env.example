# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# In CI, set these as GitHub Actions repository secrets instead of using a file.

# --- Default credentials ---------------------------------------------------
# Used by any device that does not set `credentials:` in inventory.yaml.
NETAUDIT_USERNAME=admin
NETAUDIT_PASSWORD=changeme
# Enable/secret password. Leave blank if the account already lands in enable mode.
NETAUDIT_ENABLE=

# --- Per-profile credentials ----------------------------------------------
# A device with `credentials: lab` in inventory.yaml reads NETAUDIT_LAB_*.
# The profile name is upper-cased and non-alphanumerics become underscores.
NETAUDIT_LAB_USERNAME=admin
NETAUDIT_LAB_PASSWORD=admin
NETAUDIT_LAB_ENABLE=

# Example second profile for `credentials: campus`
# NETAUDIT_CAMPUS_USERNAME=netops
# NETAUDIT_CAMPUS_PASSWORD=
# NETAUDIT_CAMPUS_ENABLE=

# --- SSH key auth (alternative to password) --------------------------------
# Set `key_file:` on the device in inventory.yaml, or point at a default here.
# NETAUDIT_KEY_FILE=~/.ssh/id_rsa
